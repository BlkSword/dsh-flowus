{
  "name": "@mars-sea/dsh-flowus",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin for FlowUs: native MCP OAuth sign-in (browser + PKCE + dynamic client registration), FlowUs MCP tools registered as native agent tools, and /flowus commands.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "0.2.0-rc.2"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test",
    "test:live": "node --test tests/flowus-live.test.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "flowus",
    "mcp",
    "oauth",
    "plugin",
    "bundle"
  ],
  "license": "Apache-2.0"
}
