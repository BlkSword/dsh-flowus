{
  "name": "@blksword/dsh-flowus",
  "version": "0.1.1",
  "description": "FlowUs for DeepSeek Harness: browser OAuth sign-in against the official FlowUs MCP server, its tools registered as native agent tools, a /flowus command, and a Settings -> FlowUs page.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "compatible",
        "0.2.1-alpha.2": "compatible"
      },
      "dsh": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || ~4.0.5-alpha.1",
    "@deepseek-ai/dsh-atomic-write": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.18.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test",
    "test:live": "node --test tests/flowus-live.test.js",
    "typecheck": "tsc -p jsconfig.json",
    "link-runtime": "node scripts/link-runtime-packages.mjs",
    "check": "npm run typecheck && node --test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "flowus",
    "mcp",
    "oauth",
    "plugin",
    "bundle",
    "settings-page"
  ],
  "author": "BlkSword <wfshenm@qq.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlkSword/dsh-flowus.git"
  },
  "bugs": {
    "url": "https://github.com/BlkSword/dsh-flowus/issues"
  },
  "homepage": "https://github.com/BlkSword/dsh-flowus#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
