{
  // Type-checks the shipped JSDoc instead of emitting anything. The plugin is
  // plain ESM JavaScript with no build step, so this is the only pass that
  // reads the annotations at all. `strict` stays off because the parameter and
  // value-schema plumbing is intentionally dynamic.
  //
  // `lib/index.js` (the cordis glue whose Context gains tools/commands/
  // connection/webServer/systemPrompt through each peer's module augmentation)
  // and `lib/client.js` (the browser bundle authored against the shell's frozen
  // module table) are excluded: a checker that cannot load those augmentations
  // would report noise there, and tests/plugin-real-services.test.js plus
  // tests/client-bundle.test.js cover both against the real services.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "types": ["node"]
  },
  "include": ["lib/**/*.js"],
  "exclude": ["lib/index.js", "lib/client.js"]
}
